# FitRight AI Server Environment Variables
# 复制此文件为 .env 并填入你的真实配置

# 数据库 (默认SQLite，无需修改)
DATABASE_URL=sqlite+aiosqlite:///./fitright.db

# JWT密钥 (生产环境请修改!)
JWT_SECRET_KEY=fitright-ai-secret-key-change-in-production

# 通义千问 API Key (必填!)
DASHSCOPE_API_KEY=sk-your-api-key-here

# 上传目录
UPLOAD_DIR=./uploads
